# Adresse du serveur OpenCode utilisé par le backend
OPENCODE_BASE_URL=http://localhost:4096

# À remplir seulement si le serveur OpenCode exige une authentification HTTP Basic
OPENCODE_USERNAME=
OPENCODE_PASSWORD=

# Facultatifs ensemble : modèle présélectionné dans GrilleTV; sans ces valeurs, défaut OpenCode
OPENCODE_PROVIDER_ID=
OPENCODE_MODEL=

# Fournisseurs appelés directement par le backend. Laissez la clé vide tant qu'elle
# n'est pas fournie par le propriétaire du compte; ne mettez jamais ces clés dans le frontend.
# Un fournisseur apparaît dans le sélecteur seulement si son modèle et, sauf Ollama, sa clé sont définis.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com

GOOGLE_API_KEY=
GOOGLE_MODEL=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

MISTRAL_API_KEY=
MISTRAL_MODEL=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Ollama local n'exige pas de clé API par défaut.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

XAI_API_KEY=
XAI_MODEL=
XAI_BASE_URL=https://api.x.ai/v1
